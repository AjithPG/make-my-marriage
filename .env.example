# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these per environment (Development / Preview / Production).

# --- App ---
# Public origin of the app. Used for the CSRF Origin check and links in emails.
APP_URL=http://localhost:3000

# --- Auth ---
# Secret mixed into every session/reset token hash. 32+ characters, never commit it.
# Changing it signs everyone out. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN_PEPPER=

# --- MongoDB Atlas (ap-south-1) ---
# App user with readWrite on the makemymarriage database. Put the db name in the path.
MONGODB_URI=mongodb+srv://<app-user>:<password>@<cluster>.mongodb.net/makemymarriage?retryWrites=true&w=majority
# Migration user with dbAdmin. Only used by `npm run migrate` and scripts; never set on Vercel.
MIGRATE_MONGODB_URI=mongodb+srv://<migrate-user>:<password>@<cluster>.mongodb.net/makemymarriage

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mm-dev
# Public media domain (custom domain or r2.dev URL), no trailing slash.
R2_PUBLIC_URL=https://media.example.com

# --- Resend ---
RESEND_API_KEY=re_
EMAIL_FROM="Make My Marriage <no-reply@example.com>"

# --- Vercel Cron ---
# Vercel sends `Authorization: Bearer $CRON_SECRET` to cron routes. 16+ random characters.
CRON_SECRET=
